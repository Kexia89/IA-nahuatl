      "responses": [
        "Kena"
      ]
    },
    {
      "tag": "axolotl_recibir_regreso",
      "patterns": [
        "Kuali ta tiualajki"
      ],
      "responses": [
        "Bueno, tlaskamati"
      ]
    },
    {
      "tag": "axolotl_recibir_visita",
      "patterns": [
        "Tlaskamati para tiualajki"
      ],
      "responses": [
        "Bueno, tlaskamati"
      ]
    },
    {
      "tag": "axolotl_recibir_elogio",
      "patterns": [
        "Kuali titekiti, ta tibuen Joven"
